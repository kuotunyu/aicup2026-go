 "rules": {
  "T1.3": "slots 1..num_games: sgf non-empty and color B/W (b/w -> upper_colour); slots after num_games: an sgf with content is FAIL_STRUCT; whitespace-only cells -> clear_slots_after_num_games_if_empty_whitespace; a colour letter B/W/b/w with an empty or whitespace-only sgf -> clear_colour_after_num_games_if_sgf_empty (PREREG_02 rev 8); any other colour value there is FAIL_STRUCT. The official colour design (competition 1 all B, competition 2 one colour per question) is recorded only",
  "T1.4": "FAIL_OPENING iff more than 1% of a file's games violate (a) no AB/AW/AE/HA/PL and SZ = 19 (a missing SZ is recorded only) or (b) at least one move, first move B, strictly alternating, no pass (B[] / B[tt])",
  "T1.5": "PASS iff the share of games whose first-move D4 class is in S99 = ['cc', 'cd', 'ce', 'cf', 'dd', 'de', 'df', 'jj'] is >= 0.95"
 },
