   "6D": 570
  }
 },
 "setup": {
  "moves": "first M moves matched by ;[BW][xy] in the SGF (passes skipped), both colours",
  "canonical_form": "the D4 symmetry (4 rotations x flip) giving the lexicographically smallest tuple of the first M points",
  "context": "(target player's colour, canonical prefix); every move of both colours is predicted",
  "smoothing": "ll_k += log((N_k(c,pre,mv) + alpha*pg) / (N_k(c,pre) + alpha)), pg = (N(c,pre,mv) + 1) / (N(c,pre) + 361), N_k = fit count at level k, N = sum over levels",
  "stop": "at the first context (c, pre) never seen in fit",
  "question": "sum of per-game ll over the k games, p = softmax(beta * sum)",
  "aggregations": {
   "mean": "beta = 1/k",
   "sqrt": "beta = 1/sqrt(k)",
   "sum": "beta = 1"
  },
  "rules": {
   "A": "argmax p",
   "B": "argmax p_k + e^-1 (p_{k-1} + p_{k+1}) (as tools/decide.py)"
  },
  "pseudo_questions": "for each round r in 0..9: rng = Random(1000 + r); for every inner player (sorted id) with >= 5 inner games: k = min(randint(5, 20), n), k games sampled without replacement",
  "metric": "official: 1 exact, e^-1 one level off, else 0; rank_balanced_mean = mean over the 10 levels of the per-level mean (main local metric); question_mean = plain mean"
 },
