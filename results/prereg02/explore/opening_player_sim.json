{
 "what": "Competition 1 opening-only player retrieval on simulated pools of FIT players (training data only, via tools/c10data.load_rows(part='fit'); no validation games, no answer files). Exploration used to freeze the PREREG_02 opening-token design.",
 "data": {
  "part": "fit",
  "games": 720307,
  "players": 5767,
  "eligible_players_by_level": {
   "D": 192,
   "C": 210,
   "B": 229,
   "A": 232,
   "1D": 146,
   "2D": 187,
   "3D": 189,
   "4D": 178,
   "5D": 189,
   "6D": 185
  },
  "eligible_rule": "players with >= 105 fit games"
 },
 "setup": {
  "own_moves_N": 10,
  "moves_parsed": "first 60 moves found in the first 2000 SGF characters",
  "pool": "40 players per level x 10 levels, chosen per seed by sha256('<seed>|<player_id>')",
  "candidates_per_player": 100,
  "query_size": "k = randint(5, 20) per player",
  "seeds": [
   0,
   1,
   2,
   3,
   4
  ],
  "vector": "per player: counts over games, weight 1 + ln(count), times idf = ln((1 + 400) / (1 + df)) + 1 with df over the pool's candidate vectors, L2-normalised; cosine similarity query vs candidate vectors",
  "metric": "official: rank r of the true player among 400, score e^-(r-1) for r <= 5, else 0; mean over the 400 queries; top1 / top5 = share with r = 1 / r <= 5; cells report the mean over seeds and the value for each seed"
 },
 "splits": {
  "random": "shuffle the player's games (rng seeded 'pool|<seed>'); candidates = first 100, query = next k (fewer if the player has < 100 + k games)",
  "fileorder": "games in file order, no shuffle; candidates = first 100, query = next k. In the training files each player's black games come first, then the white games",
  "colour_separated": "games ordered black first then white, each colour in file order (for the eligible fit players this is exactly the file order, see colour_order_check); candidates = first 100, query = the LAST q = min(k, n - 100) games, so candidates and query never overlap and the query is mostly the opposite colour of the candidates"
 },
 "token_sets": {
  "col": "colour-prefixed: own positional move 'B3:dd' + own unordered move 'B*:dd' for the first 10 own moves, plus bigrams 'Bq:Bdd>Wpp' of the first 10 moves of both colours (scratchpad name 'raw+seq')",
  "nocol": "colour-free versions: 'o3:dd', 'o*:dd', bigrams 'q:dd>pp' (scratchpad name 'nocol')",
  "both": "col + nocol",
  "own": "supplementary: col without the bigrams (scratchpad name 'raw'); only used to reproduce the scratchpad numbers (raw-vs-canon comparison, and the scratchpad 'raw+seq fileorder' run, which silently had no bigrams, see reproduction_of_scratchpad)"
 },
 "orientations": {
  "raw": "coordinates as in the SGF",
  "canon": "each game is transformed by the D4 symmetry that makes the coordinate string of its first 6 moves lexicographically minimal (transform applied to all moves)"
 },
